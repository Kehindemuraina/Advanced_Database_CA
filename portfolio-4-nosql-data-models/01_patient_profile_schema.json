{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["patient_id", "demographics", "medical_history", "longitudinal_encounters", "active_prescriptions", "immunization_history"],
    "properties": {
      "patient_id": {
        "bsonType": "int",
        "description": "Unique Master Patient Index ID - required"
      },
      "demographics": {
        "bsonType": "object",
        "required": ["first_name", "last_name", "dob", "sex", "phone", "lga"],
        "properties": {
          "first_name": { "bsonType": "string" },
          "last_name": { "bsonType": "string" },
          "dob": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "sex": { "enum": ["M", "F", "O"] },
          "phone": { "bsonType": "string" },
          "address": { "bsonType": "string" },
          "lga": { "bsonType": "string" },
          "primary_facility_code": { "bsonType": "string" }
        }
      },
      "medical_history": {
        "bsonType": "object",
        "properties": {
          "blood_group": { "bsonType": "string" },
          "genotype": { "bsonType": "string" },
          "allergies": {
            "bsonType": "array",
            "items": { "bsonType": "string" }
          },
          "chronic_conditions": {
            "bsonType": "array",
            "items": { "bsonType": "string" }
          },
          "surgical_history": {
            "bsonType": "array",
            "items": { "bsonType": "string" }
          }
        }
      },
      "longitudinal_encounters": {
        "bsonType": "array",
        "description": "Embedded array of clinical encounters avoiding relational JOINs",
        "items": {
          "bsonType": "object",
          "required": ["encounter_id", "visit_date", "facility_name", "chief_complaint"],
          "properties": {
            "encounter_id": { "bsonType": "int" },
            "visit_date": { "bsonType": "string" },
            "facility_name": { "bsonType": "string" },
            "facility_lga": { "bsonType": "string" },
            "clinician_name": { "bsonType": "string" },
            "chief_complaint": { "bsonType": "string" },
            "vital_signs": {
              "bsonType": "object",
              "properties": {
                "blood_pressure": { "bsonType": "string" },
                "temperature": { "bsonType": "number" },
                "pulse_rate": { "bsonType": "int" },
                "respiratory_rate": { "bsonType": "int" },
                "spo2": { "bsonType": "number" },
                "weight_kg": { "bsonType": "number" },
                "height_cm": { "bsonType": "number" },
                "bmi": { "bsonType": "number" }
              }
            },
            "diagnoses": {
              "bsonType": "array",
              "items": {
                "bsonType": "object",
                "properties": {
                  "icd10_code": { "bsonType": "string" },
                  "description": { "bsonType": "string" },
                  "diagnosis_type": { "bsonType": "string" }
                }
              }
            },
            "lab_investigations": {
              "bsonType": "array",
              "items": {
                "bsonType": "object",
                "properties": {
                  "test_name": { "bsonType": "string" },
                  "specimen": { "bsonType": "string" },
                  "result": { "bsonType": "string" },
                  "result_date": { "bsonType": "string" }
                }
              }
            }
          }
        }
      },
      "active_prescriptions": {
        "bsonType": "array",
        "items": {
          "bsonType": "object",
          "required": ["medication_name", "dosage", "frequency"],
          "properties": {
            "medication_name": { "bsonType": "string" },
            "dosage": { "bsonType": "string" },
            "frequency": { "bsonType": "string" },
            "duration": { "bsonType": "string" },
            "prescribed_date": { "bsonType": "string" },
            "is_active": { "bsonType": "bool" }
          }
        }
      },
      "immunization_history": {
        "bsonType": "array",
        "description": "Embedded longitudinal record of all childhood and adult vaccines",
        "items": {
          "bsonType": "object",
          "required": ["vaccine_name", "dose", "batch_number", "administration_date"],
          "properties": {
            "vaccine_name": { "bsonType": "string" },
            "dose": { "bsonType": "string" },
            "batch_number": { "bsonType": "string" },
            "administration_date": { "bsonType": "string" },
            "administering_facility": { "bsonType": "string" }
          }
        }
      }
    }
  }
}
